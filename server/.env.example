# Copy this file to .env (same folder) and fill in the real values.
# NEVER commit the real .env file. It is ignored by .gitignore.

PORT=5000

# MongoDB Atlas connection string (get the real one privately from Moontaha)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@brainbattle.xxxxxxx.mongodb.net/brainbattle?retryWrites=true&w=majority&appName=BrainBattle

# Any long random text. All 4 members should use the SAME value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React app runs (used for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

# Used by `npm run seed` to create the first admin account
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@brainbattle.local
SEED_ADMIN_PASSWORD=Admin@12345
