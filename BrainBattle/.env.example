# Copy this file to .env (same folder as BrainBattle.csproj) and fill in the real values.
# NEVER commit the real .env file. It is ignored by .gitignore.

# The app runs on http://localhost:5050 (5000 is used by AirPlay on macOS)
PORT=5050

# MongoDB Atlas connection string (the same one the team already uses; get it privately from Moontaha)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/brainbattle?retryWrites=true&w=majority

# Used by `dotnet run -- seed` to create the first admin account
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@brainbattle.local
SEED_ADMIN_PASSWORD=Admin@12345
