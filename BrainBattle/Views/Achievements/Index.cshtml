@* F17 (Moontaha): level, XP bar, activity streak and badges. *@
@model AchievementsViewModel
@{
    ViewData["Title"] = "Achievements";
    var xp = Model.XpValues;
}
<div class="container py-4">
    <h2>Achievements</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-end mb-2">
                        <span class="fs-3 fw-bold">Level @Model.Level</span>
                        <span class="text-muted">@Model.Xp XP · @(Model.NextLevelXp - Model.Xp) XP to level @(Model.Level + 1)</span>
                    </div>
                    <div class="progress" style="height: 14px">
                        <div class="progress-bar bg-warning" style="width: @(Model.LevelPercent)%"></div>
                    </div>
                    <div class="small text-muted mt-2">
                        XP per action: battle @xp.MatchPlayed (+@xp.MatchWon for a win) · puzzle @xp.PuzzleSolved · daily +@xp.DailySolved · practice @xp.PracticeCompleted · publish a quiz @xp.QuizPublished
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@Model.StreakCurrent 🔥</div>
                    <div class="text-muted small">day activity streak · best @Model.StreakBest</div>
                    @if (!Model.ActiveToday && Model.StreakCurrent > 0)
                    {
                        <div class="small text-danger mt-1">Play today to keep your streak!</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <h5>Badges (@(Model.Badges.Count(b => b.Earned))/@Model.Badges.Count)</h5>
    <div class="row g-3">
        @foreach (var b in Model.Badges)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 text-center @(b.Earned ? "border-warning" : "opacity-75")">
                    <div class="card-body">
                        <div style="font-size: 36px; filter: @(b.Earned ? "none" : "grayscale(1)")">@b.Icon</div>
                        <h6 class="mt-2 mb-1">@b.Name</h6>
                        <p class="small text-muted mb-2">@b.Description</p>
                        @if (b.Earned)
                        {
                            <span class="badge bg-warning text-dark">Earned @HtmlExtensions.Local(b.EarnedAt, "dd MMM yyyy")</span>
                        }
                        else
                        {
                            <div class="progress" style="height: 6px"><div class="progress-bar" style="width: @(b.Progress)%"></div></div>
                            <small class="text-muted">@b.Current/@b.Target</small>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
