@* VIEW (F2 Abrar): ranked queue. The searching part is live (wwwroot/js/ranked.js). *@
@model RankedIndexViewModel
@{ ViewData["Title"] = "Ranked"; }
<div class="container py-4" style="max-width: 720px">
    <h2 class="mb-1">Ranked Battle</h2>
    <p class="text-muted">We find an opponent close to your rating. Wins raise your rating, losses lower it.</p>

    @if (Model.CurrentMatchId != null)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span>You are already in a battle.</span>
            <a class="btn btn-sm btn-warning" href="/battle/@Model.CurrentMatchId">Rejoin</a>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="card text-center shadow-sm"><div class="card-body">
            <div class="small text-muted">Rating</div><div class="fs-4 fw-bold">@Model.Rating</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center shadow-sm"><div class="card-body">
            <div class="small text-muted">Tier</div><div class="fs-4 fw-bold">@Model.Tier</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center shadow-sm"><div class="card-body">
            <div class="small text-muted">Games</div><div class="fs-4 fw-bold">@Model.GamesPlayed</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card text-center shadow-sm"><div class="card-body">
            <div class="small text-muted">W / L / D</div><div class="fs-5 fw-bold">@Model.Wins / @Model.Losses / @Model.Draws</div></div></div></div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div id="idle">
                <label class="form-label" for="categoryId">Category</label>
                <select class="form-select mb-3" id="categoryId">
                    <option value="">Any category (faster)</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id">@c.Icon @c.Name</option>
                    }
                </select>
                <button id="find" class="btn btn-primary btn-lg w-100" type="button">Find match</button>
            </div>

            <div id="searching" class="text-center d-none">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <h5>Searching for an opponent… <span id="elapsed">0s</span></h5>
                <p class="text-muted mb-3">Looking for ratings within <strong id="window">±100</strong> of yours. <span id="queue"></span></p>
                <button id="cancel" class="btn btn-outline-secondary" type="button">Cancel</button>
            </div>

            <div id="found" class="text-center d-none">
                <h4 class="text-success">Opponent found!</h4>
                <p id="opponent" class="mb-0"></p>
                <p class="text-muted small">Starting the battle…</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ranked.js" asp-append-version="true"></script>
}
