@* VIEW (F1 Abrar): the live battle. Everything inside #battle is drawn by wwwroot/js/battle.js
   from the "battle:state" messages the server sends. *@
@model BattlePlayViewModel
@{ ViewData["Title"] = "Battle"; }
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">Quiz Battle</h3>
            <span class="badge bg-secondary">@Model.Mode</span>
            <span class="badge bg-info text-dark">@Model.CategoryName</span>
        </div>
        <button id="leave" class="btn btn-outline-danger btn-sm" type="button">Leave</button>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div id="battle">
                <div class="text-center text-muted py-5">Connecting…</div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold">Players</div>
                <ul id="players" class="list-group list-group-flush"></ul>
            </div>
        </div>
    </div>
</div>

@Html.JsonData("page-data", new { matchId = Model.MatchId })

@section Scripts {
    <script src="~/js/battle.js" asp-append-version="true"></script>
}
