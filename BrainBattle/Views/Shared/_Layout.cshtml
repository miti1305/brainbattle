@* SHARED layout of every page: navbar, flash messages, Bootstrap, SignalR client and site.js.
   A view can add its own script with:  @section Scripts { <script src="~/js/battle.js" asp-append-version="true"></script> } *@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var me = Context.CurrentUser();
    var path = Context.Request.Path.Value ?? "/";
    string Active(string p) => path == p || path.StartsWith(p + "/") ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@(ViewData["Title"] == null ? "BrainBattle" : ViewData["Title"] + " · BrainBattle")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-user-id="@(me?.Id)" data-username="@(me?.Username)" data-role="@(me?.Role)">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">BrainBattle</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (me != null)
                {
                    <ul class="navbar-nav me-auto">
                        @foreach (var link in FeatureCatalog.MainLinks)
                        {
                            <li class="nav-item"><a class="nav-link @Active(link.Path)" href="@link.Path">@link.Label</a></li>
                        }
                        @if (me.Role == "moderator" || me.Role == "admin")
                        {
                            <li class="nav-item"><a class="nav-link @Active("/moderation")" href="/moderation">Moderation</a></li>
                        }
                        @if (me.Role == "admin")
                        {
                            <li class="nav-item"><a class="nav-link @Active("/admin")" href="/admin">Admin</a></li>
                        }
                    </ul>
                }
                <div class="ms-auto d-flex gap-2 align-items-center">
                    @if (me != null)
                    {
                        <a class="btn btn-sm btn-outline-light position-relative" href="/notifications">
                            Notifications <span id="bb-unread" class="badge rounded-pill bg-danger ms-1 d-none">0</span>
                        </a>
                        <a class="text-light small text-decoration-none" href="/dashboard">@me.Username (@me.Role)</a>
                        <form method="post" action="/logout" asp-antiforgery="true" class="d-inline">
                            <button class="btn btn-sm btn-warning" type="submit">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" href="/login">Log in</a>
                        <a class="btn btn-sm btn-warning" href="/register">Sign up</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @ok <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
