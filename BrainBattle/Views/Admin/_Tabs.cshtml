@* F16 (Moontaha): header and tabs shared by the admin pages. Model = active tab key. *@
@model string
@{
    var tabs = new[] { ("overview", "Overview", "/admin"), ("users", "Users", "/admin/users"), ("settings", "Game settings", "/admin/settings"), ("seasons", "Seasons", "/admin/seasons") };
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2 class="mb-0">Admin dashboard</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="/admin/content">Content &amp; categories</a>
        <a class="btn btn-sm btn-outline-secondary" href="/moderation">Moderation queue</a>
    </div>
</div>
<ul class="nav nav-tabs my-3">
    @foreach (var tab in tabs)
    {
        <li class="nav-item"><a class="nav-link @(Model == tab.Item1 ? "active" : "")" href="@tab.Item3">@tab.Item2</a></li>
    }
</ul>
