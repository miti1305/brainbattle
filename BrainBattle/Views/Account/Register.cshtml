@model RegisterViewModel
@{ ViewData["Title"] = "Sign up"; }
<div class="container py-5" style="max-width: 420px">
    <h2 class="mb-4">Create account</h2>
    @if (Model.Error != null)
    {
        <div class="alert alert-danger">@Model.Error</div>
    }
    <form method="post" action="/register" asp-antiforgery="true">
        <div class="mb-3">
            <label class="form-label" for="Username">Username</label>
            <input class="form-control" id="Username" name="Username" value="@Model.Username" minlength="3" maxlength="30" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="Email">Email</label>
            <input class="form-control" type="email" id="Email" name="Email" value="@Model.Email" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="Password">Password (min 6 characters)</label>
            <input class="form-control" type="password" id="Password" name="Password" minlength="6" required />
        </div>
        <button class="btn btn-primary w-100" type="submit">Sign up</button>
    </form>
    <p class="mt-3 text-center">Already registered? <a href="/login">Log in</a></p>
</div>
